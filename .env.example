# Copy to .env locally. Never paste tokens into chat or commit .env.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# scoped: gateway + cloud ID; unscoped: direct site URL. Both use email/token Basic auth.
JIRA_TOKEN_KIND=scoped
JIRA_CLOUD_ID=
# Initial discover needs only the values above. Complete these after discovery.
JIRA_PROJECT_KEY=
JIRA_PROJECT_ID=
JIRA_SERVICE_DESK_ID=
JIRA_ALLOWED_PROJECT_KEYS=
JIRA_TEST_ISSUE_KEY=
# Writes are disabled by default. Keep true during initial discovery.
ACCESSFLOW_DRY_RUN=true
# Optional exact, user-approved connectivity comment; blank preserves the marked default.
ACCESSFLOW_PROBE_COMMENT_BODY=
# Enable only after confirming native approval configuration and read scopes.
JIRA_QUERY_APPROVALS=false
DATABASE_URL=sqlite:///data/accessflow.db
ACCESSFLOW_POLICY_PATH=config/policy.json
# Worker/API: eligible portal request type IDs discovered from your own service desk.
ACCESSFLOW_REQUEST_TYPE_IDS=
ACCESSFLOW_POLL_SECONDS=60
# Periodic source/comment rescan catches changes even without Jira updated changing.
ACCESSFLOW_RESCAN_SECONDS=300
ACCESSFLOW_RETRY_ATTEMPTS=5
# Generate a private random token of at least 32 characters; never put it in a URL.
ACCESSFLOW_ADMIN_TOKEN=
ACCESSFLOW_BIND_HOST=127.0.0.1
ACCESSFLOW_PORT=8765
# Separate authority: historical exact-comment approvals cannot enable this.
ACCESSFLOW_WORKER_WRITE_ENABLED=false
ACCESSFLOW_WRITE_POLICY_PATH=config/worker-write-policy.json
ACCESSFLOW_APPROVED_POLICY_SHA256=
LOG_LEVEL=INFO
JIRA_TIMEOUT_SECONDS=20
JIRA_READ_ATTEMPTS=3
JIRA_MAX_RETRY_WAIT_SECONDS=30
# Synthetic evaluation prototype only; the Jira worker does not import this feature.
ACCESSFLOW_LLM_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
